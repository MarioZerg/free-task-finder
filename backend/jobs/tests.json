{
  "tests": [
    {
      "name": "Радар открытых заказов",
      "method": "GET",
      "path": "/?action=feed",
      "expectedStatus": 200
    },
    {
      "name": "Лента завершённых заказов",
      "method": "GET",
      "path": "/?action=completed",
      "expectedStatus": 200
    },
    {
      "name": "Статистика сервиса",
      "method": "GET",
      "path": "/?action=stats",
      "expectedStatus": 200
    },
    {
      "name": "Мои заказы без токена",
      "method": "GET",
      "path": "/?action=mine",
      "expectedStatus": 401
    },
    {
      "name": "Переписки закрыты без токена",
      "method": "POST",
      "path": "/?action=admin_chats",
      "body": { "kind": "jobs" },
      "expectedStatus": 401
    },
    {
      "name": "Просмотр переписки закрыт без токена",
      "method": "POST",
      "path": "/?action=admin_chat",
      "body": { "kind": "job", "jobId": 1 },
      "expectedStatus": 401
    }
  ]
}