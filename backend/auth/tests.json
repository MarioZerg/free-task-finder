{
  "tests": [
    {
      "name": "Списки людей",
      "method": "GET",
      "path": "/?action=people",
      "expectedStatus": 200
    },
    {
      "name": "Без токена профиль недоступен",
      "method": "GET",
      "path": "/?action=me",
      "expectedStatus": 401
    },
    {
      "name": "Настройки входа",
      "method": "GET",
      "path": "/?action=config",
      "expectedStatus": 200
    },
    {
      "name": "Админка закрыта без прав",
      "method": "POST",
      "path": "/?action=admin_users",
      "body": {
        "role": "executor"
      },
      "expectedStatus": 403
    },
    {
      "name": "Push config",
      "method": "GET",
      "path": "/?action=push_config",
      "expectedStatus": 200,
      "expectedBody": {
        "publicKey": "string"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Список профессий",
      "method": "GET",
      "path": "/?action=professions",
      "expectedStatus": 200
    },
    {
      "name": "Неизвестное действие",
      "method": "GET",
      "path": "/?action=nope",
      "expectedStatus": 404
    },
    {
      "name": "Рассылка закрыта без прав",
      "method": "POST",
      "path": "/?action=admin_broadcast",
      "body": {
        "mode": "preview"
      },
      "expectedStatus": 403
    }
  ]
}